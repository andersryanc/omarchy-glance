#!/usr/bin/env bash
# Switch the Touch Bar between the custom renderer (Rust, or the original
# Python one with `on python`) and the t1bridge built-in.
set -euo pipefail

link="${XDG_CONFIG_HOME:-$HOME/.config}/t1bridge/renderer"
custom="$HOME/Work/touchbar-rust/target/release/touchbar"
python="$HOME/Work/touchbar/renderer.py"
config="${XDG_CONFIG_HOME:-$HOME/.config}/touchbar/config.json"
default_config="$HOME/Work/touchbar/config.default.json"

case "${1:-status}" in
  on)
    mkdir -p "$(dirname "$link")"
    if [[ "${2:-}" == "python" ]]; then target="$python"; else target="$custom"; fi
    if [[ ! -x "$target" ]]; then
      echo "$target not found; build it with: cargo build --release" >&2
      exit 1
    fi
    ln -sfn "$target" "$link"
    systemctl --user restart t1-touchbar
    echo "custom renderer on: $target"
    ;;
  off)
    rm -f "$link"
    systemctl --user restart t1-touchbar
    echo "built-in renderer on"
    ;;
  restart)
    systemctl --user restart t1-touchbar
    ;;
  status)
    if [[ -L "$link" ]]; then echo "selected: $(readlink "$link")"; else echo "selected: built-in"; fi
    systemctl --user --no-pager status t1-touchbar | sed -n '/CGroup/,$p'
    ;;
  config)
    # Create the user config from the default if needed; the renderer reloads
    # it on save.
    if [[ ! -e "$config" ]]; then
      mkdir -p "$(dirname "$config")"
      cp "$default_config" "$config"
      echo "created $config from the default"
    fi
    if [[ "${2:-}" == "edit" ]]; then exec "${EDITOR:-nvim}" "$config"; fi
    echo "$config"
    ;;
  log)
    journalctl --user -u t1-touchbar -f
    ;;
  *)
    echo "usage: touchbar-custom [on [python]|off|restart|status|log|config [edit]]" >&2
    exit 1
    ;;
esac
