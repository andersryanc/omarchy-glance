#!/usr/bin/env bash
# Switch the Touch Bar between the custom renderer and the t1bridge built-in.
set -euo pipefail

link="${XDG_CONFIG_HOME:-$HOME/.config}/t1bridge/renderer"
custom="$HOME/Work/touchbar/renderer.py"

case "${1:-status}" in
  on)
    mkdir -p "$(dirname "$link")"
    ln -sfn "$custom" "$link"
    systemctl --user restart t1-touchbar
    echo "custom renderer on"
    ;;
  off)
    rm -f "$link"
    systemctl --user restart t1-touchbar
    echo "built-in renderer on"
    ;;
  restart)
    systemctl --user restart t1-touchbar
    ;;
  status)
    if [[ -L "$link" ]]; then echo "selected: $(readlink "$link")"; else echo "selected: built-in"; fi
    systemctl --user --no-pager status t1-touchbar | sed -n '/CGroup/,$p'
    ;;
  log)
    journalctl --user -u t1-touchbar -f
    ;;
  *)
    echo "usage: touchbar-custom [on|off|restart|status|log]" >&2
    exit 1
    ;;
esac
